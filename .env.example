# .env.example (project root)
# Copy to `.env` if you want docker-compose to read overrides from here
# instead of (or in addition to) the hardcoded defaults in
# docker-compose.yml. For real deployments, set these as actual secrets
# in your hosting platform rather than committing a .env file.

POSTGRES_USER=scholar_user
POSTGRES_PASSWORD=scholar_pass
POSTGRES_DB=scholarship_db
SECRET_KEY=change-this-to-a-long-random-string
JWT_SECRET_KEY=change-this-too-different-from-secret-key
